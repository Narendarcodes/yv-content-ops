{
  "name": "content-operations-backend",
  "version": "0.1.0",
  "description": "Backend for the Content Operations & Project Memory Platform (Aaryajanani) - Node.js + Express + MongoDB",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "test:watch": "jest --runInBand --watch",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.4.0",
    "mongoose": "^7.5.0",
    "joi": "^17.9.2",
    "pino": "^8.21.0",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.22",
    "jest": "^29.5.0",
    "supertest": "^6.3.3",
    "mongodb-memory-server": "^8.11.1",
    "eslint": "^8.47.0",
    "prettier": "^3.0.0"
  }
}
